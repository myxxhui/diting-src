# diting-src 环境变量模板
# 复制为 .env 并填写实际值；.env 已在 .gitignore 中，禁止提交

# ---------- 必填（本地/联调必备）----------
TIMESCALE_DSN=postgresql://user:password@localhost:15432/diting_l1
PG_L2_DSN=postgresql://user:password@localhost:15433/diting_l2
REDIS_URL=redis://localhost:15479/0
# 与 REDIS_URL 同步（deep-strike publisher 读取；未设 DEEP_STRIKE_REDIS_URL 时回退 REDIS_URL）
# DEEP_STRIKE_REDIS_URL=redis://localhost:15479/0

# ---------- LLM（信号层/MoE 需要）----------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# ---------- 可选 ----------
# DITING_SRC_ROOT=.        # 仓库根路径，容器内通常为 /app

# ---------- 持仓 SoT（六维度共享）----------
# 启动期所有维度（D1/D2/D3/D4/D0）默认仅对本 SoT 中 active=true 的标的拉真实数据。
# 模板见 data/config/my_holdings.example.yaml；私有 yaml 路径写入此变量：
# MY_HOLDINGS_YAML=data/config/my_holdings.yaml

# ===== cryo_guard · step_02 财报采集（前缀 CRYO_）=====
# CRYO_DB_URL=sqlite+aiosqlite:///./data/cryo_guard.db
# CRYO_MOCK 已禁用（no-mock-policy）；见 apps/common/no_mock_policy.py
# 以下可二选一或混用（shell export 优先于 .env；.env 与 YAML 见 crawl_env_bootstrap）
# CRYO_SYMBOL_LIST=training/data/config/crawl_symbols.example.txt
# CRYO_YEARS=2022,2023,2024
# 或 CRYO_YEAR_START=2022 CRYO_YEAR_END=2024
# CRYO_MAX_SYMBOLS=10
# CRYO_REPORT_TYPES=annual
# CRYO_THROTTLE_SEC=0.6
# 公告：默认巨潮 cninfo（免费公开披露，PDF 全文入 announcements.content）；东财仅元数据 CRYO_ANN_BACKEND=eastmoney
# CRYO_ANN_FETCH_FULLTEXT=1
# CRYO_ANN_MAX_ITEMS=200
# CRYO_ANN_PAGE_SIZE=30
# CRYO_ANN_MAX_PAGES=20
# 附注关联方：先自巨潮下年报 PDF 再 OCR — CRYO_NOTES_FETCH_PDF=1（与上列标的/年度一致）
# CRYO_NOTES_PDF_MAX_BYTES=83886080
# CRYO_NOTES_QUERY_MAX_PAGES=10
# 公告拉取时间窗与上列年度一致（min(年)-01-01 .. max(年)-12-31），无需单独设公告起止日
# 使用 YAML：复制 training/data/config/crawl_financial.example.yaml 为私有路径后填写：
# CRYO_CRAWL_CONFIG=training/data/config/crawl_financial.yaml

# ---------- Copilot（M3 告警等，前缀 COPILOT_）----------
COPILOT_DB_URL=sqlite+aiosqlite:///./data/copilot.db
COPILOT_REDIS_URL=redis://localhost:6379/0
COPILOT_WECHAT_WEBHOOK=
COPILOT_TELEGRAM_BOT_TOKEN=
COPILOT_TELEGRAM_CHAT_ID=
# 126：开启 SMTP 后使用授权码（非登录密码）；465 + SSL
COPILOT_SMTP_HOST=smtp.126.com
COPILOT_SMTP_PORT=465
COPILOT_SMTP_USE_SSL=true
COPILOT_SMTP_USERNAME=your_name@126.com
COPILOT_SMTP_PASSWORD=
COPILOT_SMTP_FROM=your_name@126.com
COPILOT_SMTP_TO=your_inbox@gmail.com
COPILOT_ALERT_DEDUP_WINDOW=3600
COPILOT_ALERT_RED_SLA=300
COPILOT_ALERT_CONSUMER_ENABLED=true

# === M4 价值账本 ===
COPILOT_LEDGER_REPORTS_DIR=./data/reports
COPILOT_CIRCUIT_WINDOW=20
COPILOT_CIRCUIT_BH_THRESHOLD=0.35
COPILOT_MONTHLY_CRON_DAY=1
COPILOT_MONTHLY_CRON_HOUR=9
# 测试环境建议 false，避免 APScheduler 后台任务
COPILOT_LEDGER_SCHEDULER_ENABLED=true

# === step_07 日报 / 周报（APScheduler cron · 上海时区由运行环境决定）===
COPILOT_DAILY_REPORT_TIME=08:00
# holdings_merged = W1 health + W2 market_phase 合并早报（推荐）；legacy = 原告警/SCS 日报
COPILOT_DAILY_REPORT_MODE=holdings_merged
# 早报生成前刷新：1=跑探针+阶段分类（慢，全量约 10–15 分钟）
MORNING_BRIEF_REFRESH=1
MORNING_BRIEF_RUN_PROBES=1
MORNING_BRIEF_RUN_PHASE=1
# COPILOT_WEEKLY_REPORT_DAY=sun
# COPILOT_WEEKLY_REPORT_TIME=18:00
# === step_08 月报 PDF + Redis 熔断管理 ===
# 完整验证（WeasyPrint + pdfminer + §3.11）：见仓库 Makefile「docker-step08-*」与 docker-compose.copilot.yml
# 架构师专用企微 webhook（与用户告警 COPILOT_WECHAT_WEBHOOK 隔离；可为空则通知跳过）
# COPILOT_ARCHITECT_WECHAT_WEBHOOK=
# POST /api/admin/circuit-breaker/reset 须带 Header: x-admin-token
# COPILOT_ADMIN_TOKEN=

# ===== super-evo（演进飞轮，前缀 SUPER_EVO_）=====
SUPER_EVO_PORT=8090
SUPER_EVO_REDIS_URL=redis://localhost:6379/5
SUPER_EVO_MINIO_ENDPOINT=http://localhost:9000
SUPER_EVO_MINIO_ACCESS_KEY=minioadmin
SUPER_EVO_MINIO_SECRET_KEY=minioadmin
SUPER_EVO_MINIO_BUCKET=super-evo
SUPER_EVO_WANDB_PROJECT=diting-super-evo
SUPER_EVO_WANDB_MODE=online

# WandB / Teacher（本地可填真实 key；无 key 时 SUPER_EVO_WANDB_MODE=offline 亦可跑通 health）
# WANDB_API_KEY=

# ---------- Anthropic · 双模型分层 ----------
# ANTHROPIC_API_KEY=sk-ant-...          # 必填：Lighthouse 远程脑力 + C1 Teacher 蒸馏
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# TEACHER_MODEL=claude-claude-sonnet-4-5     # D5 Teacher 批量蒸馏（性价比，sonnet 级）
# LIGHTHOUSE_REMOTE_MODEL=claude-opus-4-6   # Lighthouse Opus：Architect/Critic/Timer/Scorer
# ANTHROPIC_MODEL=claude-opus-4-6           # 兜底（未设 TEACHER_MODEL/LIGHTHOUSE_REMOTE_MODEL 时读此值）
# RADAR_T2_ENABLED=true                      # 行情雷达模式 C 深度研报 T2 Opus 开关；关则前端显式提示未就绪（不伪造）
# ---------- DeepSeek · 雷达 T1 事实矩阵压缩 ----------
# DEEPSEEK_API_KEY=sk-...                    # T1 压缩（OpenAI 兼容 API）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# RADAR_T1_MODE=auto                         # auto|deepseek|rule；auto=有 key 用 DeepSeek
# RADAR_DEEPSEEK_IN_USD_PER_MTOK=0.27
# RADAR_DEEPSEEK_OUT_USD_PER_MTOK=1.10
# 雷达 T2 研报复用窗口（小时，默认 7×24；生产无 HTTPS_PROXY 时依赖预拉缓存）
# RADAR_T2_CACHE_MAX_AGE_HOURS=168
# 雷达 A+B：Mac make radar-t0-prefetch-with-t2 → diting-infra make radar-t0-sync → 生产读缓存（含 9 维 T2）
# 仅 T0：make radar-t0-prefetch
# RADAR_T0_CACHE_DIR=data/cache/radar_t0
# RADAR_T0_CACHE_MAX_AGE_HOURS=24              # 文件新鲜度（默认 24h）
# RADAR_T0_RETENTION_DAYS=1                    # 文件 versions 目录清理（天，默认 1=24h）
# RADAR_FILE_RETENTION_HOURS=24                # 波次四 · 文件缓存保留（与上条等价优先本项）
# RADAR_DB_RETENTION_DAYS=30                   # 波次四 · DB bundle 保留天数
# RADAR_DB_MAX_VERSIONS=7                        # 波次四 · 每标的最多版本数（审计切换）
# RADAR_RECENT_ANALYSIS_DAYS=7                 # 波次四 · 扫描候选区展示近 N 日分析标的
# RADAR_CHAT_DEFAULT_MODEL=claude-opus-4-6     # Opus 对话默认模型
# RADAR_T0_LIVE_FALLBACK=true                  # 遗留项；扫描 cache miss 始终尝试 live（部分源失败可接受）
# P1 · QMT 桥接（Windows 侧 HTTP 服务；未配置则 T0-8 走 MarketQuote/akshare）
# RADAR_QMT_BRIDGE_URL=http://192.168.x.x:8787
# P1 · 融资日表探针（SSE 全表极慢，默认关；扩展期可开）
# RADAR_T0_MARGIN_ENABLE=0
# RADAR_T0_AKSHARE_TIMEOUT_SEC=30
# RADAR_T0_AKSHARE_RETRY=2
# RADAR_T0_EM_TIMEOUT_SEC=25
# RADAR_T0_EM_RETRY=3
# RADAR_T0_EM_THROTTLE_SEC=0.35
# 生产 B 路径 · 仅 Opus/Anthropic 出口代理（勿设 HTTPS_PROXY，否则 akshare T0 会 403）
# ANTHROPIC_HTTPS_PROXY=http://用户名:密码@新加坡代理IP:3128
# 兼容旧键：copilot-sync 仍可读 HTTPS_PROXY，但 sync-anthropic-proxy 会迁移为上一行并删除 HTTPS_PROXY

