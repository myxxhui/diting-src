# diting-src 环境变量模板
# 复制为 .env 并填写实际值；.env 已在 .gitignore 中，禁止提交

# ---------- 必填（本地/联调必备）----------
TIMESCALE_DSN=postgresql://user:password@localhost:15432/diting_l1
PG_L2_DSN=postgresql://user:password@localhost:15433/diting_l2
REDIS_URL=redis://localhost:15479/0

# ---------- LLM（信号层/MoE 需要）----------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# ---------- 可选 ----------
# DITING_SRC_ROOT=.        # 仓库根路径，容器内通常为 /app
# DITING_INGEST_MOCK=0     # 1 = 使用 Mock 数据跑通流程

# ---------- Copilot（M3 告警等，前缀 COPILOT_）----------
COPILOT_DB_URL=sqlite+aiosqlite:///./data/copilot.db
COPILOT_REDIS_URL=redis://localhost:6379/0
COPILOT_WECHAT_WEBHOOK=
COPILOT_TELEGRAM_BOT_TOKEN=
COPILOT_TELEGRAM_CHAT_ID=
COPILOT_SMTP_HOST=smtp.resend.com
COPILOT_SMTP_PORT=587
COPILOT_SMTP_USERNAME=
COPILOT_SMTP_PASSWORD=
COPILOT_SMTP_FROM=copilot@example.com
COPILOT_SMTP_TO=
COPILOT_ALERT_DEDUP_WINDOW=3600
COPILOT_ALERT_RED_SLA=300
COPILOT_ALERT_CONSUMER_ENABLED=true

# === M4 价值账本 ===
COPILOT_LEDGER_REPORTS_DIR=./data/reports
COPILOT_CIRCUIT_WINDOW=20
COPILOT_CIRCUIT_BH_THRESHOLD=0.35
COPILOT_MONTHLY_CRON_DAY=1
COPILOT_MONTHLY_CRON_HOUR=9
# 测试环境建议 false，避免 APScheduler 后台任务
COPILOT_LEDGER_SCHEDULER_ENABLED=true
