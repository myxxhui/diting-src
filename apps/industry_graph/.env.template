# ============================================================
# diting-src/apps/industry_graph/.env.template
# 产业图谱服务 — 环境变量配置模板
# 复制到 .env 后填入实际值
# ============================================================

# ---- Neo4j 图数据库 ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# ---- PostgreSQL L2（共享 copilot 的 PG L2 实例）----
PG_L2_DSN=postgresql+asyncpg://postgres:postgres@localhost:5433/diting

# ---- Redis（共享 ARQ 任务队列，db=2 隔离）----
REDIS_URL=redis://localhost:6379/2

# ---- AI 模型 ----
CLAUDE_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-3-5-sonnet-20240620
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ---- 服务配置 ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8090
LOG_LEVEL=INFO
CORS_ORIGINS=*

# ---- 功能开关 ----
ENABLE_LLM_REASONING=true
ENABLE_AUTO_MONITOR=false        # Phase 3 开启
ENABLE_GRAPH_RAG=false           # Phase 3 开启
