# 技术雷达 · 工作目录环境变量模板
# 复制为 .env 并填写实际值（.env 不入库，手动管理）
#
# 使用：
#   cp .env.template .env
#   填入 DASHSCOPE_API_KEY
#   然后执行 python3 -m apps.tech_radar.pipeline

# ══════════════════════════════════════════
# 必填
# ══════════════════════════════════════════

# 阿里云 DashScope API Key
# 开通「通义听悟」服务后，在 https://bailian.console.aliyun.com/ 获取
# 实时转写 ¥0.016/分钟
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ══════════════════════════════════════════
# 可选（有默认值）
# ══════════════════════════════════════════

# 每日 ASR 转写预算上限（分钟）
DAILY_BUDGET_MINUTES=60

# ASR 每分钟预估费用（¥），仅用于花费统计
ASR_COST_PER_MINUTE=0.016

# 过短视频过滤阈值（秒），短于该值的视频自动跳过
MIN_VIDEO_DURATION_SEC=30

# ── 目录配置（相对于工作目录）
# WeChatVideoDownloader 的下载指向这里
VIDEO_DIR=原始视频

# ffmpeg 输出的临时音频
AUDIO_DIR=音频缓冲

# 最终输出 .md 文件
OUTPUT_DIR=文本输出
