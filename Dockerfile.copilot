# Copilot 生产运行镜像（K3s / Helm）
# 加速：依赖层与 apps 分离 · pip BuildKit 缓存 · 仅安装 [copilot,pdf-verify]
# [Ref: 03_/00_维度零/stages/stage_1_启动期/steps/step_10 §Deploy]
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    COPILOT_DB_URL=sqlite+aiosqlite:////data/copilot.db \
    COPILOT_LEDGER_REPORTS_DIR=/data/reports

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    shared-mime-info \
    libcairo2 \
    libharfbuzz0b \
    libpangoft2-1.0-0 \
    fonts-noto-cjk \
    tesseract-ocr \
    tesseract-ocr-chi-tra \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── 依赖层（pyproject 变更才重建；改 apps/ 不触发 pip）────────────────────
COPY pyproject.toml README.md ./
RUN mkdir -p apps/common apps/copilot scripts \
    && touch apps/__init__.py apps/common/__init__.py apps/copilot/__init__.py scripts/.keep

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel \
    && pip install -e ".[copilot,pdf-verify]"

# Playwright Chromium（鸿海 IR / MOPS 渲染页 · fii_twse_cloud）
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN playwright install --with-deps chromium

# ── 代码层（editable 已指向 /app，仅 COPY 即可生效）────────────────────────
COPY apps ./apps
COPY scripts ./scripts
# DeepSea probe_registry · Cursor 路由真相源（[Ref: 28_ §2.13 · 29_ §5.4]）
COPY data/config/probe_registry ./data/config/probe_registry
COPY data/config/executing_profiles ./data/config/executing_profiles
# Z0 宏观风向标 · metric_registry / 政策 RSS / 关键词（[Ref: 29_ §5.1 · 34_ §3.2]）
COPY data/config/metrics ./data/config/metrics

RUN mkdir -p /data /data/reports /config

COPY scripts/copilot_k8s_entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)"

ENTRYPOINT ["/entrypoint.sh"]
